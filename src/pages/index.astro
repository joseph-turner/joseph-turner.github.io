---
import About from '@components/sections/About/About.astro';
import FeaturedProjects from '@components/sections/FeaturedProjects.astro';
import Hero from '@components/sections/Hero.astro';
import Layout from '@layouts/Layout.astro';

import RecentPosts from '../components/sections/RecentPosts/RecentPosts.astro';
---

<Layout>
  <section
    class="relative overflow-hidden bg-white dark:bg-gray-950"
  >
    <Hero />
  </section>
  <section
    class="relative z-10 border-y border-gray-200/70 bg-gray-50 px-4 py-20 dark:border-white/10 dark:bg-gray-900/40"
  >
    <About />
  </section>
  <FeaturedProjects />
  <RecentPosts />
</Layout>
