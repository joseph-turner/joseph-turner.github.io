---
import HeaderLink from './HeaderLink.astro';
---

<header
  class="sticky top-0 z-50 w-full border-b border-gray-200/70 bg-white/85 backdrop-blur-xl dark:border-white/10 dark:bg-gray-950/85"
>
  <div
    class="container mx-auto flex items-center justify-between px-6 py-3"
  >
    <a
      class="group inline-flex items-center gap-3 rounded-md text-gray-950 transition hover:text-primary-700 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:outline-none dark:text-white dark:hover:text-primary-300"
      href="/"
    >
      <span
        class="flex h-9 w-9 items-center justify-center rounded-md bg-gray-950 text-sm font-black text-white shadow-sm transition group-hover:bg-primary-700 dark:bg-white dark:text-gray-950 dark:group-hover:bg-primary-200"
      >
        JT
      </span>
      <span class="hidden leading-tight sm:block">
        <span class="block text-sm font-bold">Joseph Turner</span
        >
        <span
          class="block text-xs font-medium text-gray-500 dark:text-gray-400"
        >
          Senior Front-End Developer
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      <HeaderLink href="/">Home</HeaderLink>
      <HeaderLink href="/resume">Resume</HeaderLink>
      <HeaderLink href="/blog">Blog</HeaderLink>
    </nav>

    <div class="flex items-center gap-2">
      <button
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation"
        class="rounded-md p-2 text-gray-700 transition hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:outline-none md:hidden dark:text-white dark:hover:bg-white/10"
        id="mobile-menu-button"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M4 6h16M4 12h16M4 18h16"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>
  <nav
    class="hidden border-t border-gray-200/70 bg-white/95 md:hidden dark:border-white/10 dark:bg-gray-950/95"
    id="mobile-menu"
  >
    <ul class="space-y-1 px-4 pt-3 pb-4">
      <li><HeaderLink href="/">Home</HeaderLink></li>
      <li><HeaderLink href="/resume">Resume</HeaderLink></li>
      <li><HeaderLink href="/blog">Blog</HeaderLink></li>
    </ul>
  </nav>
</header>

<script is:inline>
  const mobileMenuButton = document.getElementById(
    'mobile-menu-button'
  );
  const mobileMenu = document.getElementById('mobile-menu');
  mobileMenuButton.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
    mobileMenuButton.setAttribute(
      'aria-expanded',
      String(!mobileMenu.classList.contains('hidden'))
    );
  });
</script>
