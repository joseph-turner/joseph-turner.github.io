---
const capabilities = [
  {
    title: 'Front-end architecture',
    description:
      'Building React and Next.js interfaces that stay fast, maintainable, and easy to evolve.',
  },
  {
    title: 'Design/dev bridge',
    description:
      'Translating product intent into polished UI details without losing technical clarity.',
  },
  {
    title: 'Performance polish',
    description:
      'Improving load time, interaction quality, and everyday user experience where it matters.',
  },
];
---

<div class="container mx-auto max-w-6xl">
  <div
    class="grid items-start gap-10 rounded-xl border border-gray-200 bg-white p-6 shadow-sm md:grid-cols-[0.85fr_1.15fr] md:p-10 dark:border-white/10 dark:bg-gray-950"
  >
    <div>
      <p
        class="text-sm font-bold text-primary-600 uppercase dark:text-primary-300"
      >
        About
      </p>
      <h2
        class="mt-3 text-3xl font-black tracking-tight text-gray-950 md:text-4xl dark:text-white"
      >
        Design instincts, engineering discipline.
      </h2>
      <p
        class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300"
      >
        I’m Joseph Turner, a Senior Front-End Developer with 13+
        years of experience building web products that feel
        clean, quick, and dependable. I started in design, so I
        care as much about the fit and finish as I do about the
        system underneath.
      </p>
    </div>

    <div class="grid gap-4 sm:grid-cols-3 md:grid-cols-1">
      {
        capabilities.map((capability) => (
          <article class="rounded-lg border border-gray-200 bg-gray-50 p-5 transition hover:border-primary-200 hover:bg-white hover:shadow-sm dark:border-white/10 dark:bg-white/5 dark:hover:border-primary-400/30 dark:hover:bg-white/10">
            <h3 class="text-base font-black text-gray-950 dark:text-white">
              {capability.title}
            </h3>
            <p class="mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300">
              {capability.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</div>
