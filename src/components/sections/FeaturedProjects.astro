---
import projects from '../../data/projects.ts';

const maxVisibleProjects = 3;
---

<section class="bg-white py-20 dark:bg-gray-950" id="projects">
  <div class="container mx-auto max-w-6xl px-6">
    <div
      class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end"
    >
      <div>
        <p
          class="text-sm font-bold text-primary-600 uppercase dark:text-primary-300"
        >
          Featured work
        </p>
        <h2
          class="mt-3 text-3xl font-black tracking-tight text-gray-950 md:text-4xl dark:text-white"
        >
          Project previews
        </h2>
      </div>
      <p
        class="max-w-xl text-base leading-7 text-gray-600 dark:text-gray-300"
      >
        Placeholder case-study panels for selected work. Final
        imagery and live links can drop into this structure
        without changing the page rhythm.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        projects.slice(0, maxVisibleProjects).map((project) => (
          <article class="group overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-primary-200 hover:shadow-lg hover:shadow-gray-900/10 dark:border-white/10 dark:bg-gray-900 dark:hover:border-primary-400/30">
            <div class="relative flex aspect-[16/10] items-end overflow-hidden bg-gray-950 p-5">
              <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(38,144,215,0.35),transparent_45%),linear-gradient(315deg,rgba(251,147,115,0.32),transparent_42%)]" />
              <div class="absolute inset-x-0 top-0 h-px bg-white/30" />
              <div class="absolute top-5 right-5 h-14 w-14 rounded-lg border border-white/15 bg-white/10" />
              <div class="absolute top-16 right-20 h-24 w-32 rounded-lg border border-white/10 bg-white/5" />
              <div class="relative">
                <p class="text-xs font-bold text-primary-200 uppercase">
                  Preview pending
                </p>
                <p class="mt-2 max-w-48 text-xl font-black text-white">
                  {project.title}
                </p>
              </div>
            </div>

            <div class="p-6">
              <h3 class="text-xl font-black text-gray-950 dark:text-white">
                {project.title}
              </h3>
              <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
                {project.description}
              </p>

              <div class="mt-5 flex flex-wrap gap-2">
                {project.tech.map((tech) => (
                  <span class="rounded-md border border-gray-200 bg-gray-50 px-2.5 py-1 text-xs font-bold text-gray-600 dark:border-white/10 dark:bg-white/5 dark:text-gray-300">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="mt-6 flex gap-3 text-sm font-bold">
                <span class="text-gray-400 dark:text-gray-500">
                  Case study soon
                </span>
                <span class="text-gray-300 dark:text-gray-700">
                  /
                </span>
                <span class="text-gray-400 dark:text-gray-500">
                  Links pending
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
