---
import { getCollection } from 'astro:content';

import {
  getBlogPath,
  sortBlogPostsByDateDesc,
} from '../../../lib/blog';

const posts = (await getCollection('blog'))
  .sort(sortBlogPostsByDateDesc)
  .slice(0, 3); // limit to 3 recent posts
---

<section
  class="border-t border-gray-200/70 bg-gray-50 py-20 dark:border-white/10 dark:bg-gray-900/40"
>
  <div class="mx-auto max-w-6xl px-6">
    <div
      class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end"
    >
      <div>
        <p
          class="text-sm font-bold text-primary-600 uppercase dark:text-primary-300"
        >
          Writing
        </p>
        <h2
          class="mt-3 text-3xl font-black tracking-tight text-gray-950 md:text-4xl dark:text-white"
        >
          Recent blog posts
        </h2>
      </div>
      <a
        class="inline-flex w-fit rounded-md border border-gray-300 px-4 py-2 text-sm font-bold text-gray-700 transition hover:border-primary-300 hover:text-primary-700 dark:border-white/15 dark:text-gray-300 dark:hover:border-primary-400/40 dark:hover:text-primary-300"
        href="/blog"
      >
        View all posts
      </a>
    </div>

    <ul class="grid gap-6 md:grid-cols-3">
      {
        posts.map((post) => (
          <li>
            <a
              href={getBlogPath(post)}
              class="group block h-full rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-primary-200 hover:shadow-lg hover:shadow-gray-900/10 dark:border-white/10 dark:bg-gray-950 dark:hover:border-primary-400/30"
            >
              <time
                datetime={post.data.date.toISOString()}
                class="text-sm font-bold text-primary-600 dark:text-primary-300"
              >
                {post.data.date.toLocaleDateString()}
              </time>
              <h3 class="mt-4 text-xl leading-7 font-black text-gray-950 transition group-hover:text-primary-700 dark:text-white dark:group-hover:text-primary-300">
                {post.data.title}
              </h3>
              <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
                {post.data.description}
              </p>
              <span class="mt-6 inline-flex text-sm font-bold text-gray-500 transition group-hover:text-primary-700 dark:text-gray-400 dark:group-hover:text-primary-300">
                Read post
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
